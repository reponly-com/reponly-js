{
  "name": "reponly",
  "version": "0.1.5",
  "description": "Live chat and customer support SDK for Reponly: build your own in-app support chat widget, with real-time messages, file uploads and live visitors. No dependencies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "reponly",
    "live-chat",
    "chat-widget",
    "support-chat",
    "customer-support",
    "customer-chat",
    "helpdesk",
    "in-app-chat",
    "support-widget",
    "intercom-alternative",
    "crisp-alternative",
    "tawk-alternative",
    "realtime",
    "typescript",
    "sdk"
  ],
  "homepage": "https://reponly.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reponly-com/reponly-js.git"
  },
  "bugs": {
    "url": "https://github.com/reponly-com/reponly-js/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
